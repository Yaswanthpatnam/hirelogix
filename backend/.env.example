# ==============================================================================
# HireLogix Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with your actual credentials.
# NEVER commit the active .env file to version control.
# ==============================================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# For PostgreSQL (Neon, Render, Supabase, or Local Postgres):
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# --- Google OAuth 2.0 & Gmail Integration ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/user/auth/google/callback/
GMAIL_GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/oauth/callback/

# --- Frontend Application URL (for CORS and OAuth Redirection) ---
FRONTEND_URL=http://localhost:5173

# --- AI Engine: Groq LPU (Primary High-Speed Cloud Inference) ---
# Get your free API key at: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL_NAME=qwen/qwen3.8-27b

# --- AI Engine: Ollama (Secondary Offline Local Fallback) ---
# Optional: Used when running locally with an active Ollama daemon
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
